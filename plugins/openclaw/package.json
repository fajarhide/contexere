{
  "name": "@fajarhide/veng-signal-engine",
  "version": "0.5.9",
  "description": "Local-only semantic context filtering for OpenClaw using VENG. Saves tokens by distilling shell output.",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "openclaw": "^2026.9.6",
    "typescript": "^7.0.2"
  },
  "openclaw": {
    "extensions": ["./index.ts"],
    "compat": {
      "pluginApi": ">=2026.4.11"
    },
    "build": {
      "openclawVersion": "2026.4.11"
    }
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "hono": "4.13.13",
    "undici": "8.12.2"
  }
}
